{
  "name": "ratatoskr-telemetry-views",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ratatoskr's telemetry views. Each view draws one scry contract and builds to one self-contained HTML file.",
  "scripts": {
    "dev": "vite",
    "sync-contracts": "node scripts/sync-contracts.mjs",
    "gen-types": "node scripts/gen-types.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && playwright test",
    "check": "node scripts/sync-contracts.mjs --check && node scripts/gen-types.mjs --check && npm run typecheck && npm test",
    "push": "npm run build && ./scripts/push.sh"
  },
  "dependencies": {
    "@fontsource-variable/pixelify-sans": "5.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-singlefile": "^2.1.0",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
