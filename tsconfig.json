{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@contracts/*": [
        "./src/contracts/*/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "views/**/*.ts",
    "views/**/*.vue",
    "views/**/*.json",
    "vite.config.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
